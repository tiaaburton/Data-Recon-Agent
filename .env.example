# =============================================================================
# Enterprise Data Reconciliation Agent: Environment Configuration
# Copy this file to .env.local and populate with your credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Salesforce CRM Live Environment Configuration
# -----------------------------------------------------------------------------
# Base instance URL (lightning or my.salesforce.com domain)
SFDC_INSTANCE_URL="https://your-org-dev-ed.develop.my.salesforce.com"

# Authentication: Basic / Username-Password with Connected App or Direct Token
SFDC_USERNAME="your-user@agentforce.com"
SFDC_PASSWORD="your-salesforce-password-with-security-token"

# Connected App OAuth Credentials (Required if using OAuth2 Web Server / Client Credentials)
SFDC_CLIENT_ID="3MVG9...your_connected_app_client_id"
SFDC_CLIENT_SECRET="your_connected_app_client_secret"
SFDC_API_VERSION="v60.0"

# Target Object & Schema Mapping:
# - Target Object: Opportunity (Standard) linked to Account & Contract
# - Correlation Field: Opportunity.Name (contains [CTR-2026-XXXX]) & Opportunity.Description (JSON metadata)
SFDC_TARGET_OBJECT="Opportunity"
SFDC_CORRELATION_FIELD="Name"

# -----------------------------------------------------------------------------
# 2. ServiceNow ITSM Live Environment Configuration
# -----------------------------------------------------------------------------
# Base instance URL (e.g. Developer Instance or Corporate Instance)
SERVICENOW_INSTANCE_URL="https://devXXXXX.service-now.com"

# Authentication: Basic Auth credentials
SERVICENOW_USERNAME="admin"
SERVICENOW_PASSWORD="your-dev-instance-password"

# Target Table & Schema Mapping:
# - Target Table: incident (Standard ITSM table present out-of-the-box in all instances)
# - Correlation Field: correlation_id (Standard ServiceNow Task field)
# - Dispute Details: description (JSON metadata containing disputed_amount and sap_invoice_ref)
SERVICENOW_TABLE="incident"
SERVICENOW_CORRELATION_FIELD="correlation_id"
SERVICENOW_DISPUTE_AMOUNT_FIELD="description"

# -----------------------------------------------------------------------------
# 3. Google Cloud Platform & Vertex AI Configuration
# -----------------------------------------------------------------------------
GCP_PROJECT_ID="your-enterprise-gcp-project-id"
GCP_REGION="us-central1"
ENVIRONMENT="development" # development | staging | production

# Strategic Model Routing: Gemini 3.x Family
MODEL_ROUTER_FLASH="gemini-3.7-flash-preview"
MODEL_ROUTER_PRO="gemini-3.1-pro"

# Vertex AI Agent Engine & Cloud Run BYO-MCP
AGENT_SERVICE_URL="https://data-recon-server-xxxx-uc.a.run.app"
FIRESTORE_DATABASE_ID="(default)"
PUBSUB_TOPIC_RECON_EVENTS="recon-discrepancy-events"
PUBSUB_TOPIC_RECON_DLQ="recon-dead-letter-queue"

# -----------------------------------------------------------------------------
# 4. Security, DLP & HITL Cryptographic Configuration
# -----------------------------------------------------------------------------
# HMAC Secret for HITL signed mutation tokens (generate with: openssl rand -hex 32)
HITL_SIGNING_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Cloud KMS Single-Region CMEK Key
KMS_KEY_NAME="projects/your-gcp-project-id/locations/us-central1/keyRings/recon-keyring/cryptoKeys/recon-key"

# Cloud DLP Inspection Template
DLP_INSPECT_TEMPLATE="projects/your-gcp-project-id/inspectTemplates/recon-pii-scrubber"
