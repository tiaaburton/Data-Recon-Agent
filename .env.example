# =============================================================================
# Enterprise Data Reconciliation Agent: Base Environment Template (.env.example)
# Copy this file to .env and adjust variables for your target organization.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Salesforce CRM Configuration
# -----------------------------------------------------------------------------
SFDC_INSTANCE_URL="https://your-org-dev-ed.develop.my.salesforce.com"
SFDC_API_VERSION="v60.0"
SFDC_TARGET_OBJECT="Opportunity"
SFDC_CORRELATION_FIELD="Name"

# -----------------------------------------------------------------------------
# 2. ServiceNow ITSM Configuration
# -----------------------------------------------------------------------------
SERVICENOW_INSTANCE_URL="https://devXXXXX.service-now.com"
SERVICENOW_TABLE="incident"
SERVICENOW_CORRELATION_FIELD="correlation_id"
SERVICENOW_DISPUTE_AMOUNT_FIELD="description"

# -----------------------------------------------------------------------------
# 3. Google Cloud Platform & Vertex AI Configuration
# -----------------------------------------------------------------------------
GCP_PROJECT_ID="your-enterprise-gcp-project-id"
GCP_REGION="us-central1"
ENVIRONMENT="development"

# Strategic Model Routing: Gemini 3.x Family
MODEL_ROUTER_FLASH="gemini-3.7-flash-preview"
MODEL_ROUTER_PRO="gemini-3.1-pro"

# Vertex AI Agent Engine & Cloud Run BYO-MCP
AGENT_SERVICE_URL="http://localhost:8080"
FIRESTORE_DATABASE_ID="(default)"
PUBSUB_TOPIC_RECON_EVENTS="recon-discrepancy-events"
PUBSUB_TOPIC_RECON_DLQ="recon-dead-letter-queue"

# -----------------------------------------------------------------------------
# 4. Security, DLP & HITL Cryptographic Configuration
# -----------------------------------------------------------------------------
HITL_SIGNING_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
KMS_KEY_NAME="projects/your-gcp-project-id/locations/us-central1/keyRings/recon-keyring/cryptoKeys/recon-key"
DLP_INSPECT_TEMPLATE="projects/your-gcp-project-id/inspectTemplates/recon-pii-scrubber"
