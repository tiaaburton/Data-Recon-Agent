#!/usr/bin/env bash
# ==============================================================================
# Git Pre-Commit Hook
# ==============================================================================
set -euo pipefail

CYAN='\033[36m'
GREEN='\033[32m'
RED='\033[31m'
RESET='\033[0m'

echo -e "${CYAN}🔍 [pre-commit] Running validations...${RESET}"

# 1. Format Check for Staged Go Files
echo -e "${CYAN}  • Checking gofmt on staged Go files...${RESET}"
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.go$' | grep -v 'internal/agentengine' || true)

if [ -n "$STAGED_GO_FILES" ]; then
  UNFORMATTED=$(gofmt -l $STAGED_GO_FILES || true)
  if [ -n "$UNFORMATTED" ]; then
    echo -e "${RED}❌ Unformatted Go files detected:${RESET}"
    echo "$UNFORMATTED"
    echo -e "${CYAN}  Auto-formatting unformatted files...${RESET}"
    gofmt -s -w $UNFORMATTED
    git add $UNFORMATTED
    echo -e "${GREEN}  ✓ Auto-formatted and re-staged files.${RESET}"
  fi
fi

# 2. Go Vet
echo -e "${CYAN}  • Running go vet on cmd, pkg, and tests...${RESET}"
go vet ./cmd/... ./pkg/... ./tests/...

# 3. GolangCI-Lint (if installed)
GOLANGCI_BIN=$(which golangci-lint 2>/dev/null || which $(go env GOPATH)/bin/golangci-lint 2>/dev/null || which $HOME/go/bin/golangci-lint 2>/dev/null || true)
if [ -n "$GOLANGCI_BIN" ] && [ -x "$GOLANGCI_BIN" ]; then
  echo -e "${CYAN}  • Running golangci-lint ($GOLANGCI_BIN)...${RESET}"
  $GOLANGCI_BIN run --config=.golangci.yml
fi

# 4. Fast Unit & Evaluation Tests
echo -e "${CYAN}  • Running unit & evaluation benchmarks...${RESET}"
go test -short ./tests/... ./pkg/...

# 5. Check Terraform formatting (if staged)
STAGED_TF_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.tf$' || true)
if [ -n "$STAGED_TF_FILES" ] && command -v terraform >/dev/null 2>&1; then
  echo -e "${CYAN}  • Validating Terraform formatting...${RESET}"
  terraform -chdir=terraform fmt -check
fi

echo -e "${GREEN}✅ [pre-commit] All checks passed successfully!${RESET}"
