# =============================================================================
# Enterprise Data Reconciliation Agent: Local Credential Overrides (.env.local.example)
# Copy this file to .env.local and populate with your sandbox credentials.
# Note: .env.local is strictly gitignored to protect sensitive developer credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Salesforce CRM Local Credentials
# -----------------------------------------------------------------------------
SFDC_INSTANCE_URL="https://your-org-dev-ed.develop.my.salesforce.com"
SFDC_USERNAME="your-username@agentforce.com"
SFDC_PASSWORD="your-salesforce-password-with-security-token"
SFDC_CLIENT_ID="your-connected-app-client-id"
SFDC_CLIENT_SECRET="your-connected-app-client-secret"
SFDC_API_VERSION="v60.0"

# -----------------------------------------------------------------------------
# 2. ServiceNow ITSM Local Credentials
# -----------------------------------------------------------------------------
SERVICENOW_INSTANCE_URL="https://devXXXXX.service-now.com"
SERVICENOW_USERNAME="admin"
SERVICENOW_PASSWORD="your-servicenow-admin-password"
SERVICENOW_TABLE="incident"
SERVICENOW_CORRELATION_FIELD="correlation_id"
SERVICENOW_DISPUTE_AMOUNT_FIELD="description"

# -----------------------------------------------------------------------------
# 3. Google Cloud Platform Local Overrides
# -----------------------------------------------------------------------------
GCP_PROJECT_ID="your-local-gcp-project-id"
GCP_REGION="us-central1"
GEMINI_API_KEY="your-gemini-api-key"
